@{
    ViewData["Title"] = "Pet Grooming ";
}

<!-- Hero Section -->
<section class="home-hero-banner">
    <div class="container">
        <div class="home-hero-content">
            <h1 class="home-hero-title">
                <span class="text-gold">Welcome</span> To<br />
                PickA<span class="text-gold">Groom!</span> 🐾
            </h1>

            <p class="home-hero-text">
                Professional grooming services tailored for Pets.<br />
                Book your appointment right now.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Appointment" asp-action="Create" class="btn-teal-pill">
                    Book an Appointment Now
                </a>
                <a asp-controller="Appointment" asp-action="Index" class="btn-outline-brown-pill">
                    View All Services
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Featured Services Section -->
<div class="container my-5">
    <h3 class="text-center mb-4 font-display" style="color: var(--teal-primary); font-size: 2.1rem;">
        Our Popular Services
    </h3>
    <div class="row">
    </div>
</div>