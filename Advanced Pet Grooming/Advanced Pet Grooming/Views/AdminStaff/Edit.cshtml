@model Advanced_Pet_Grooming.Models.Staff
@{
    ViewData["Title"] = "Edit Staff / Groomer Profile";
}

<div class="container mt-4" style="max-width: 650px;">
    <h2>Edit Staff / Groomer Profile</h2>
    <hr />

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="staff_id" />
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="staff_name" class="form-label fw-bold">Full Name</label>
            <input asp-for="staff_name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="role" class="form-label fw-bold">Role</label>
            <select asp-for="role" class="form-select" required>
                <option value="Groomer">Groomer</option>
                <option value="Staff">Staff</option>
                <option value="Admin">Admin</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="email" class="form-label fw-bold">Email Address</label>
            <input asp-for="email" type="email" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="phone_no" class="form-label fw-bold">Phone Number</label>
            <input asp-for="phone_no" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="account_status" class="form-label fw-bold">Account Status</label>
            <select asp-for="account_status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="newPassword" class="form-label fw-bold">Reset Password (leave blank to keep current)</label>
            <input type="password" name="newPassword" id="newPassword" class="form-control" minlength="6" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Update Profile</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>