@model Advanced_Pet_Grooming.Models.Pet

@{
    ViewData["Title"] = "Delete Pet";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Delete Pet</h2>
        <p class="text-muted">
            Review the pet information before deleting.
        </p>
    </div>

    <!-- Warning Message -->
    <div class="alert alert-warning">
        <strong>Warning!</strong>
        Are you sure you want to delete this pet profile?
        This action cannot be undone.
    </div>

    <!-- Pet Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-light">
            <h5 class="mb-0">Pet Information</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Pet Photo -->
                <div class="col-md-4 mb-3">

                    @if (Model.PetPhotos != null && Model.PetPhotos.Any())
                    {
                        <img src="@Model.PetPhotos.First().PhotoPath"
                             alt="@Model.pet_name"
                             class="img-fluid rounded"
                             style="width:100%; height:220px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center rounded"
                             style="height:220px;">
                            <span class="text-muted">
                                No Pet Photo
                            </span>
                        </div>
                    }

                </div>

                <!-- Pet Details -->
                <div class="col-md-8">

                    <h4 class="fw-bold">@Model.pet_name</h4>

                    <p>
                        <strong>Pet Type:</strong>
                        @Model.pet_type
                    </p>

                    <p>
                        <strong>Breed:</strong>
                        @(Model.breed ?? "Not specified")
                    </p>

                    <p>
                        <strong>Gender:</strong>
                        @Model.gender
                    </p>

                    <p>
                        <strong>Age:</strong>
                        @Model.age years
                    </p>

                    <p>
                        <strong>Weight:</strong>
                        @Model.weight kg
                    </p>

                    <p>
                        <strong>Pet Size:</strong>
                        @Model.size_category
                    </p>

                    <p>
                        <strong>Vaccination:</strong>

                        @if (Model.is_vaccinated)
                        {
                            <span class="badge bg-success">
                                Vaccinated
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                Not Vaccinated
                            </span>
                        }
                    </p>

                </div>

            </div>

        </div>
    </div>

    <!-- Delete Confirmation -->
    <form asp-action="Delete"
          asp-controller="Pet"
          asp-route-id="@Model.pet_id"
          method="post">

        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-danger">
                Confirm Delete
            </button>

        </div>

    </form>

</div>
