@model IEnumerable<Advanced_Pet_Grooming.Models.Announcement>
@{
    ViewData["Title"] = "Announcements";
}

<h1>Announcements</h1>

@if (ViewBag.Notice != null)
{
    <div class="alert alert-info">
        @ViewBag.Notice
    </div>
}

<form asp-controller="Announcements"
      asp-action="Index"
      method="get"
      class="mb-3">
    <div class="input-group">
        <input name="searchKeyword"
               value="@ViewBag.SearchKeyword"
               class="form-control"
               placeholder="Search announcements" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (Model.Any())
{
    foreach (var announcement in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2>@announcement.Title</h2>

                <p class="text-muted">
                    @announcement.Date.ToString("yyyy-MM-dd")
                </p>

                <p>@announcement.Description</p>

                @if (!string.IsNullOrEmpty(announcement.ImagePath))
                {
                    <img src="@announcement.ImagePath"
                         alt="@announcement.Title"
                         class="img-fluid" />
                }

                @if (ViewBag.IsAdmin == true)
                {
                    <a asp-controller="Announcements"
                       asp-action="Edit"
                       asp-route-id="@announcement.AnnouncementId"
                       class="btn btn-secondary">
                        Edit
                    </a>
                }
            </div>
        </div>
    }
}
else if (ViewBag.Notice == null)
{
    <p>No announcements found.</p>
}